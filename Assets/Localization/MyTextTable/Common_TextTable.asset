  - m_fieldName: Store.Cobdom.Describe
    m_keys: 000000000100000002000000030000000400000005000000
    m_values:
    - "\u4E00\u6B21\u6027\u907F\u5B55\u7528\u54C1\uFF0C\u80FD\u964D\u4F4E\u61F7\u5B55\u98A8\u96AA\u3002"
