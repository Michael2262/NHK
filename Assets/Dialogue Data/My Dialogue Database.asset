      - title: zh-CN
        value: "\u4F46\u8981\u5C0F\u5FC3\u59B9\u59B9\u68C0\u67E5\uFF0C\u9700\u8981\u300C\u957F\u6309\u300DDANGER\u6309\u94AE\u505C\u4E0B\u624B\u8FB9\u52A8\u4F5C\uFF01"
        type: 4
        typeString: CustomFieldType_Localization
      - title: en
        value: But watch out for her checking; you must long-press the DANGER button
